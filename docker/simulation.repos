repositories:
  src/cmeresearch_msgs:
    type: git
    url: https://github.com/cme-research/cmeresearch_msgs.git
    version: main

  src/cmeresearch_description:
    type: git
    url: https://github.com/cme-research/cmeresearch_description.git
    version: main

  src/cmeresearch_bringup:
    type: git
    url: https://github.com/cme-research/cmeresearch_bringup.git
    version: main

  src/cmeresearch_robot_state:
    type: git
    url: https://github.com/cme-research/cmeresearch_robot_state.git
    version: jazzy_dev

  src/dual_laser_merger:
    type: git
    url: https://github.com/cme-research/dual_laser_merger.git
    version: jazzy_dev

  # Needed for the end-to-end webapp test stack: the mqtt_bridge_node in
  # cmexaiii_nav_stack.launch.py bridges ROS↔MQTT between the sim and the
  # webapp container (started via the docker-compose `webapp` profile).
  src/mqtt_bridge:
    type: git
    url: https://github.com/cme-research/mqtt_bridge.git
    version: jazzy
