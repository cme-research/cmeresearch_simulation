<?xml version="1.0"?>
<!--
  Simulation robot description for CMEXAIII.

  Identical to the kinematic URDF from cmeresearch_description but replaces
  the ros2_control hardware plugin with webots_ros2_control::Ros2ControlSystem
  so the controller_manager picks up the correct plugin when running in Webots.

  Used by robot_state_publisher in cmexaiii_webots.launch.py.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mecanumdrive_robot">
  <xacro:arg name="prefix" default="" />

  <!-- Kinematic description (links, joints, visuals, sensors) -->
  <xacro:include filename="$(find cmeresearch_description)/urdf/cmexaiii/robot_properties.urdf.xacro" />
  <xacro:include filename="$(find cmeresearch_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find cmeresearch_description)/urdf/cmexaiii/robot_description.urdf.xacro" />
  <xacro:include filename="$(find cmeresearch_description)/urdf/cmexaiii/robot_mecanum.ros2_control.xacro" />

  <!-- Instantiate robot links/joints -->
  <xacro:cmexaiii prefix="$(arg prefix)" />

  <!--
    ros2_control section with Webots hardware plugin.
    The controller_manager (started inside webots_ros2_driver) subscribes to
    /robot_description and loads this plugin instead of the real hardware one.
  -->
  <ros2_control name="cmexaiii" type="system">
    <hardware>
      <plugin>webots_ros2_control::Ros2ControlSystem</plugin>
    </hardware>
    <joint name="$(arg prefix)front_left_wheel_joint">
      <param name="sensor">$(arg prefix)front_left_wheel_joint_sensor</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="$(arg prefix)rear_left_wheel_joint">
      <param name="sensor">$(arg prefix)rear_left_wheel_joint_sensor</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="$(arg prefix)front_right_wheel_joint">
      <param name="sensor">$(arg prefix)front_right_wheel_joint_sensor</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="$(arg prefix)rear_right_wheel_joint">
      <param name="sensor">$(arg prefix)rear_right_wheel_joint_sensor</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
