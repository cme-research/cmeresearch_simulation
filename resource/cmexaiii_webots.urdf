<?xml version="1.0"?>
<!--
  Webots driver configuration URDF for CMEXAIII.

  This file is passed to webots_ros2_driver (WebotsController) and configures:
    1. The ros2_control hardware plugin (webots_ros2_control::Ros2Control)
       – maps Webots RotationalMotor / PositionSensor nodes to ros2_control
         velocity-command / position-and-velocity-state interfaces.
    2. The two LiDAR sensors (Webots Lidar nodes) with correct ROS frame IDs.

  This is NOT the robot's full kinematic URDF (that comes from
  cmeresearch_description and is used by robot_state_publisher).

  RotationalMotor names in the .wbt file must exactly match joint names here:
    front_left_wheel_joint   front_right_wheel_joint
    rear_left_wheel_joint    rear_right_wheel_joint

  PositionSensor names in the .wbt file must be {joint_name}_sensor.
-->
<robot name="cmexaiii">

  <!-- ros2_control hardware interface via Webots -->
  <ros2_control name="webots" type="system">
    <hardware>
      <plugin>webots_ros2_control::Ros2Control</plugin>
    </hardware>

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!--
    LiDAR sensor configuration.
    The Webots Lidar device named "scan_front_left" publishes LaserScan on
    /scan_front_left by default; we set the frame_id to the URDF link name.
  -->
  <sensor name="scan_front_left">
    <ros2>
      <param name="frameName">base_laser_front_left</param>
    </ros2>
  </sensor>

  <sensor name="scan_rear_right">
    <ros2>
      <param name="frameName">base_laser_rear_right</param>
    </ros2>
  </sensor>

</robot>
