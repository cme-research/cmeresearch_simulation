<?xml version="1.0"?>
<!--
  Webots driver configuration URDF for CMEXAIII.

  Passed to webots_ros2_driver (WebotsController). Configures:
    1. Webots plugin activation (<webots> section)
    2. LiDAR topic names and frame IDs
    3. ros2_control hardware plugin + joint interfaces

  RotationalMotor names in .wbt must match joint names exactly.
  PositionSensor names must be {joint_name}_sensor.
-->
<robot name="cmexaiii">

  <!-- Webots driver plugins and device configuration -->
  <webots>

    <!-- Activate the ros2_control Webots plugin -->
    <plugin type="webots_ros2_control::Ros2Control" />

    <!-- LiDAR sensors: publish on /scan_front_left and /scan_rear_right -->
    <device reference="scan_front_left" type="Lidar">
      <ros>
        <enabled>true</enabled>
        <updateRate>10</updateRate>
        <topicName>/scan_front_left</topicName>
        <alwaysOn>true</alwaysOn>
        <frameName>base_laser_front_left</frameName>
      </ros>
    </device>

    <device reference="scan_rear_right" type="Lidar">
      <ros>
        <enabled>true</enabled>
        <updateRate>10</updateRate>
        <topicName>/scan_rear_right</topicName>
        <alwaysOn>true</alwaysOn>
        <frameName>base_laser_rear_right</frameName>
      </ros>
    </device>

  </webots>

  <!-- ros2_control hardware interface via Webots -->
  <ros2_control name="webots" type="system">
    <hardware>
      <plugin>webots_ros2_control::Ros2ControlSystem</plugin>
    </hardware>

    <joint name="front_left_wheel_joint">
      <param name="sensor">front_left_wheel_joint_sensor</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <param name="sensor">front_right_wheel_joint_sensor</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <param name="sensor">rear_left_wheel_joint_sensor</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <param name="sensor">rear_right_wheel_joint_sensor</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
