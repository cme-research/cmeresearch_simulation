# ── CMEXAIII Robot ────────────────────────────────────────────────────────────
# Robot is spawned in Room A, facing north (-Z direction).
# Translation Y = wheel_radius (0.05 m) so wheels sit on the floor.
#
# Webots frame mapping to ROS frame (handled by webots_ros2_driver):
#   Webots -Z  <->  ROS +X  (forward)
#   Webots -X  <->  ROS +Y  (left)
#   Webots +Y  <->  ROS +Z  (up)
#
# Wheel positions (Webots frame, relative to robot origin):
#   front_left  : X = -track/2 = -0.177,  Y = 0,  Z = -wheelbase/2 = -0.150
#   front_right : X = +track/2 = +0.177,  Y = 0,  Z = -wheelbase/2 = -0.150
#   rear_left   : X = -track/2 = -0.177,  Y = 0,  Z = +wheelbase/2 = +0.150
#   rear_right  : X = +track/2 = +0.177,  Y = 0,  Z = +wheelbase/2 = +0.150
#
# All wheels: HingeJoint axis = (1, 0, 0); positive velocity -> forward (-Z) motion.
# RotationalMotor names match URDF joint names consumed by mecanum_drive_controller.

DEF CMEXAIII Robot {
  translation -4 0.05 -2
  rotation 0 1 0 0
  name "cmexaiii"
  model "CMEXAIII"
  description "CME Research CMEXAIII mecanum drive robot"
  controller "<extern>"
  synchronization FALSE

  children [

    # ── Chassis body ──────────────────────────────────────────────────────────
    DEF CHASSIS Solid {
      translation 0 0.525 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.22 0.22 0.28
            roughness 0.6
            metalness 0.35
          }
          geometry Box {
            size 0.55 1.0 1.1
          }
        }
      ]
      name "chassis"
    }

    # ── Front-Left Wheel ──────────────────────────────────────────────────────
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor -0.177 0 -0.150
      }
      device [
        RotationalMotor {
          name "front_left_wheel_joint"
          maxVelocity 15
          maxTorque 100
        }
        PositionSensor {
          name "front_left_wheel_joint_sensor"
        }
      ]
      endPoint DEF WHEEL_FL Solid {
        translation -0.177 0 -0.150
        rotation 0 0 1 1.5707963
        name "front_left_wheel"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.08 0.08 0.08
              roughness 0.95
            }
            geometry Cylinder {
              radius 0.05
              height 0.05
            }
          }
        ]
        boundingObject Cylinder {
          radius 0.05
          height 0.05
        }
        physics Physics {
          density -1
          mass 0.3
        }
      }
    }

    # ── Front-Right Wheel ─────────────────────────────────────────────────────
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor 0.177 0 -0.150
      }
      device [
        RotationalMotor {
          name "front_right_wheel_joint"
          maxVelocity 15
          maxTorque 100
        }
        PositionSensor {
          name "front_right_wheel_joint_sensor"
        }
      ]
      endPoint DEF WHEEL_FR Solid {
        translation 0.177 0 -0.150
        rotation 0 0 1 1.5707963
        name "front_right_wheel"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.08 0.08 0.08
              roughness 0.95
            }
            geometry Cylinder {
              radius 0.05
              height 0.05
            }
          }
        ]
        boundingObject Cylinder {
          radius 0.05
          height 0.05
        }
        physics Physics {
          density -1
          mass 0.3
        }
      }
    }

    # ── Rear-Left Wheel ───────────────────────────────────────────────────────
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor -0.177 0 0.150
      }
      device [
        RotationalMotor {
          name "rear_left_wheel_joint"
          maxVelocity 15
          maxTorque 100
        }
        PositionSensor {
          name "rear_left_wheel_joint_sensor"
        }
      ]
      endPoint DEF WHEEL_RL Solid {
        translation -0.177 0 0.150
        rotation 0 0 1 1.5707963
        name "rear_left_wheel"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.08 0.08 0.08
              roughness 0.95
            }
            geometry Cylinder {
              radius 0.05
              height 0.05
            }
          }
        ]
        boundingObject Cylinder {
          radius 0.05
          height 0.05
        }
        physics Physics {
          density -1
          mass 0.3
        }
      }
    }

    # ── Rear-Right Wheel ──────────────────────────────────────────────────────
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor 0.177 0 0.150
      }
      device [
        RotationalMotor {
          name "rear_right_wheel_joint"
          maxVelocity 15
          maxTorque 100
        }
        PositionSensor {
          name "rear_right_wheel_joint_sensor"
        }
      ]
      endPoint DEF WHEEL_RR Solid {
        translation 0.177 0 0.150
        rotation 0 0 1 1.5707963
        name "rear_right_wheel"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.08 0.08 0.08
              roughness 0.95
            }
            geometry Cylinder {
              radius 0.05
              height 0.05
            }
          }
        ]
        boundingObject Cylinder {
          radius 0.05
          height 0.05
        }
        physics Physics {
          density -1
          mass 0.3
        }
      }
    }

    # ── Front-Left LiDAR ──────────────────────────────────────────────────────
    # URDF position (ROS): (0.460, 0.257, 0.18) -> Webots (-0.257, 0.18, -0.460)
    # Topic: /scan_front_left  Frame: base_laser_front_left
    Lidar {
      translation -0.257 0.18 -0.460
      rotation 0 1 0 -0.785
      name "scan_front_left"
      horizontalResolution 720
      fieldOfView 6.2832
      numberOfLayers 1
      near 0.05
      minRange 0.1
      maxRange 8.0
      noise 0.01
    }

    # ── Rear-Right LiDAR ──────────────────────────────────────────────────────
    # URDF position (ROS): (-0.460, -0.257, 0.18) -> Webots (0.257, 0.18, 0.460)
    # Topic: /scan_rear_right  Frame: base_laser_rear_right
    Lidar {
      translation 0.257 0.18 0.460
      rotation 0 1 0 2.356
      name "scan_rear_right"
      horizontalResolution 720
      fieldOfView 6.2832
      numberOfLayers 1
      near 0.05
      minRange 0.1
      maxRange 8.0
      noise 0.01
    }

  ]

  # Chassis bounding object (covers body; wheels have their own)
  boundingObject Pose {
    translation 0 0.525 0
    children [
      Box {
        size 0.55 1.0 1.1
      }
    ]
  }

  physics Physics {
    density -1
    mass 17.7
    centerOfMass [ 0 0.5 0 ]
  }
}
