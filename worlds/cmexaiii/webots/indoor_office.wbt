#VRML_SIM R2025a utf8

# Indoor office / lab environment for CMEXAIII mecanum robot Webots simulation.
# Self-contained: uses only built-in Webots nodes, no EXTERNPROTOs, so the
# world loads instantly without any download or local PROTO installation.
#
# Layout: two connected rooms (7 x 12 m each) with a 1.5 m door opening,
# scattered box obstacles, and tables along the walls.
#
# Coordinate system (Webots NUE):  X = East / right,  Y = up,  Z = South / backward
# Robot faces  -Z  (north) by default.
#
# Room A (left):  X in [-7, 0],  Z in [-6, 6]
# Room B (right): X in [ 0, 7],  Z in [-6, 6]
# Doorway: on dividing wall at X = 0, Z in [-0.75, 0.75]

WorldInfo {
  title "CMEXAIII Indoor Office"
  info [
    "Webots R2025a simulation for CME Research CMEXAIII mecanum robot"
    "Two-room office layout, 14 x 12 m total area"
    "Uses webots_ros2_control and mecanum_drive_controller"
  ]
  basicTimeStep 32
  coordinateSystem "NUE"
}

Viewpoint {
  fieldOfView 0.9
  orientation -0.326 -0.318 -0.89 1.61
  position -1.6 18.5 -13.3
}

Background {
  skyColor [
    0.55 0.65 0.78
  ]
}

DirectionalLight {
  ambientIntensity 0.5
  direction -0.4 -1 -0.3
  intensity 0.9
  castShadows TRUE
}

DirectionalLight {
  ambientIntensity 0.3
  direction 0.5 -0.5 0.4
  intensity 0.4
}

# ── Floor ─────────────────────────────────────────────────────────────────────
DEF FLOOR Solid {
  translation 0 -0.025 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.78 0.65 0.45
        roughness 0.9
        metalness 0.0
      }
      geometry Box {
        size 14 0.05 12
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 14 0.05 12
  }
}

