<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cmeresearch_simulation</name>
  <version>0.2.0</version>
  <description>
    Simulation environments for CME Research AMRs.
    Provides Stage worlds (legacy) and Webots worlds with full ROS 2 integration
    for the CMEXAIII mecanum robot.
  </description>
  <maintainer email="info@cme-robotics.com">cmerobotics</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Webots simulation -->
  <exec_depend>webots_ros2_driver</exec_depend>
  <exec_depend>webots_ros2_control</exec_depend>

  <!-- Robot description and control -->
  <exec_depend>cmeresearch_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>mecanum_drive_controller</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <!-- Full simulation stack -->
  <exec_depend>dual_laser_merger</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>cmeresearch_robot_state</exec_depend>
  <exec_depend>cmeresearch_bringup</exec_depend>

  <!-- Launch infrastructure -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
